# Copy to .env and fill in what you need. .env is gitignored - never commit it.
#
#     cp .env.example .env
#
# Everything here is optional. With none of it set, the pipeline still runs end to end
# against the local chain using the scripted Bing backend.


# --- Reverse image search fallback -------------------------------------------------
# Only needed if the scripted Bing backend is being rate-limited. Free tier is 100
# searches/month at https://serpapi.com - no payment required.
# Used by: py run.py --backend serpapi --image-url <public url of your image>
SERPAPI_KEY=


# --- Base Sepolia (optional) --------------------------------------------------------
# Only needed for `--chain sepolia`. `--chain local` needs no wallet at all.
#
# USE A BURNER WALLET. This key signs transactions. Generate a fresh one, fund it from a
# Base Sepolia faucet, and never put a wallet here that holds anything real. A private key
# in a file on a development machine should be worth nothing if it leaks.
#
# No leading 0x is required; either form works.
PRIVATE_KEY=

# Override only if the public endpoint is unreliable for you.
BASE_SEPOLIA_RPC=https://sepolia.base.org
